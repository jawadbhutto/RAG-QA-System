# Copy this file to `.env` and adjust as needed.
# Using a local Ollama model — no API key required, but Ollama must be
# installed and running (`ollama serve`), with the model already pulled
# (e.g. `ollama pull qwen2.5:3b`).

# --- LLM API key(s) --- (only needed if you switch LLM_MODEL to a cloud provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# --- Vector storeQ ---
COLLECTION_NAME=rag_question_answering
DISTANCE_METRIC=cosine

# --- Retrieval ---
TOP_K=4
RELEVANCE_THRESHOLD=0.5

# --- LLM (answer generation) ---
# "provider:model" string. For local Ollama models, use the exact tag
# shown by `ollama list` (it already contains a colon, e.g. "qwen2.5:3b"
# or "llama3.1:8b") — that's expected and handled correctly.
LLM_MODEL=ollama:qwen2.5:3b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
# Only used for the ollama provider; default matches Ollama's own default.
OLLAMA_BASE_URL=http://localhost:11434

# --- Conversation memory ---
MAX_HISTORY_TURNS=5
CONTEXTUALIZE_FOLLOWUPS=true

# --- Logging ---
LOG_LEVEL=INFO
